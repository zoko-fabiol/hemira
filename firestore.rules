rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // CMS collections: Publicly readable for website visitors, writable for admin
    match /site_content/{docId} {
      allow read: if true;
      allow write: if true;
    }
    match /site_settings/{docId} {
      allow read: if true;
      allow write: if true;
    }
    match /services/{docId} {
      allow read: if true;
      allow write: if true;
    }
    match /case_studies/{docId} {
      allow read: if true;
      allow write: if true;
    }
    match /site_media/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // Forms and inquiries
    match /quotes/{quoteId} {
      allow create: if request.resource.data.clientEmail is string 
                    && request.resource.data.clientPhone is string;
      allow read, update, delete: if true;
    }
    match /contacts/{contactId} {
      allow create: if request.resource.data.email is string;
      allow read, delete: if true;
    }
    match /chat_inquiries/{inquiryId} {
      allow create: if request.resource.data.userMessage is string;
      allow read, delete: if true;
    }
  }
}
